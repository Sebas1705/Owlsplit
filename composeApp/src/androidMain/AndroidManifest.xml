<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-sdk tools:overrideLibrary="io.kamel.image" />
    <!-- Banking apps for Bizum (BankApps.SPANISH_BANKS): without this Android 11+ hides whether they are installed. -->
    <queries>
        <package android:name="com.bbva.bbvacontigo" />
        <package android:name="es.lacaixa.mobile.android.newwapicon" />
        <package android:name="es.bancosantander.apps" />
        <package android:name="net.inverline.bancosabadell.officelocator.android" />
        <package android:name="www.ingdirect.nativeframe" />
        <package android:name="com.imaginbank.app" />
        <package android:name="com.bankinter.launcher" />
        <package android:name="es.openbank.mobile" />
        <package android:name="es.unicajabanco.app" />
        <package android:name="com.abanca.bancamovil.particulares" />
        <package android:name="com.kutxabank.android" />
        <package android:name="es.ibercaja.ibercajaapp" />
        <package android:name="com.grupocajamar.wefferent" />
        <package android:name="com.rsi.nba" />
        <package android:name="com.tecnocom.cajalaboral" />
        <package android:name="es.evobanco.bancamovil" />
        <package android:name="com.myinvestor.es" />
        <package android:name="es.eurocajarural.EurocajaRural" />
        <package android:name="es.caixaontinyent.caixaontinyentapp" />
        <package android:name="com.mediolanum.android.fullbanca" />
    </queries>
    <application
        android:name=".KmpApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="true"
        android:supportsRtl="true">
        <!-- On in staging and production only (composeApp/build.gradle.kts, crashReporting). -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsEnabled}" />
        <!-- singleTask: an invite link opens the running app (onNewIntent) instead of a second copy. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Invite links (P10b), verified with /.well-known/assetlinks.json on the Hosting site. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${inviteHost}" />
                <data android:pathPrefix="/j/" />
            </intent-filter>
        </activity>
        <!-- Home-screen balance widget, with "add expense" (BalanceWidget). -->
        <receiver
            android:name=".widget.BalanceWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/balance_widget_info" />
        </receiver>
        <!-- Group exports (P12b): shared as content:// URIs, see AndroidFileSharer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
